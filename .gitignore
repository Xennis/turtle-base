# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Coverage reports
/apps/*/coverage/
/packages/*/coverage/

# Local mise config (Google Drive sync OAuth values) - see
# .mise.local.toml.example.
.mise.local.toml

# OpenTofu (ops/infra) - state and local files, see ops/infra/README.md.
# .terraform.lock.hcl stays committed (provider dependency lock).
ops/infra/.terraform/
ops/infra/*.tfstate
ops/infra/*.tfstate.*
ops/infra/terraform.tfvars
ops/infra/crash.log

# TypeScript workspace (pnpm, Vite+)
node_modules/
dist/
*.tsbuildinfo
