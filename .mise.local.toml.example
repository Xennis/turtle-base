# Local, gitignored mise config - copy to `.mise.local.toml` and fill in your
# own values. mise puts them into the environment of its tasks (see mise.toml),
# where the build bundles them into the app's page - see
# packages/crdt-file-sync-google-drive/README.md for where they come from.
# Without them the app runs with Drive sync disabled.
[env]
DRIVE_DESKTOP_CLIENT_ID = "your-desktop-client-id.apps.googleusercontent.com"
DRIVE_DESKTOP_CLIENT_SECRET = "your-desktop-client-secret"
